# FastAPI Backend Environment Variables

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database
DATABASE_URL=sqlite:///./truck_delivery.db
# For PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost/truck_delivery

# CORS
CORS_ORIGINS=http://localhost:8000,http://localhost:3000,http://127.0.0.1:8000

# App
APP_NAME=Truck Delivery Management API
VERSION=1.0.0
DEBUG=True
